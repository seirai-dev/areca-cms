{
  "name": "@areca/demo-site",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "predev": "pnpm run paraglide",
    "prebuild": "pnpm run paraglide && node --env-file-if-exists=.env.local ./scripts/prebuild.mjs",
    "pretypecheck": "pnpm run paraglide",
    "pretest": "pnpm run paraglide",
    "precontent:fixture": "pnpm run paraglide",
    "content:pull": "node --env-file-if-exists=.env.local ./node_modules/@areca-cms/site-sdk/dist/cli.js pull --out src/generated/content",
    "content:fixture": "tsx ./scripts/fixture-content.ts",
    "sync-manifest": "node --env-file-if-exists=.env.local --import tsx ./node_modules/@areca-cms/site-sdk/dist/cli.js manifest push ./areca.config.ts",
    "dev": "node --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js dev --port 3001",
    "build": "vite build",
    "build:static": "pnpm run prebuild && VITE_STATIC_EXPORT=true vite build && cp .output/public/404/index.html .output/public/404.html && cp .output/public/nl/404/index.html .output/public/nl/404.html && pnpm run write:health && pnpm run verify:prerender",
    "write:health": "tsx ./scripts/write-static-health.ts",
    "start": "node .output/server/index.mjs",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:prerender": "tsx ./scripts/verify-prerender.ts"
  },
  "dependencies": {
    "@areca-cms/site-sdk": "workspace:*",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/paraglide-js": "^3.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/markdown": "1.2.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/start-static-server-functions": "1.167.44",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
