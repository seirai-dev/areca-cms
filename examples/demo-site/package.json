{
  "name": "@areca/demo-site",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prebuild": "node --env-file-if-exists=.env.local ./scripts/prebuild.mjs",
    "content:pull": "node --env-file-if-exists=.env.local ./node_modules/@areca/site-sdk/dist/cli.js pull --out src/generated/content",
    "content:fixture": "tsx ./scripts/fixture-content.ts",
    "sync-manifest": "node --env-file-if-exists=.env.local --import tsx ./node_modules/@areca/site-sdk/dist/cli.js sync-manifest ./areca.config.ts",
    "dev": "node --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js dev --port 3001",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:prerender": "tsx ./scripts/verify-prerender.ts"
  },
  "dependencies": {
    "@areca/site-sdk": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/markdown": "0.0.15",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.33",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  }
}
