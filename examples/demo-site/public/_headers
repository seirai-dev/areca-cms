# Response headers on Cloudflare (read by Workers static assets, not served).
# Ignored by the Node build.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Hashed build assets never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Written by scripts/write-static-health.ts. The CMS health check must see the
# new publication right after a deploy.
/api/health
  Content-Type: application/json
  Cache-Control: no-store
