CMS_IMAGE=ghcr.io/seirai-dev/areca-cms:latest
CMS_PORT=3000
CMS_URL=http://localhost:3000

REDIS_URL=
DATABASE_URL=

# Required. The CMS refuses to start in production without a real value.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_URL=
S3_ACCESS_KEY=areca-demo
S3_SECRET_KEY=areca-demo-storage-secret
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=areca
S3_FORCE_PATH_STYLE=true
# Optional installation path in a shared private bucket. Unset/empty = bucket root.
# Examples: areca or sites/production; /areca/ normalizes to areca.
# Rejects slash-only, whitespace/control chars, backslashes, internal //, . or .. segments.
# All CMS and maintenance writers must agree. No automatic migration/root fallback.
# Reset deletes every object in this subtree (whole bucket when unset/empty).
# Scopes requests only, not credential permissions. See https://docs.arecacms.com/docs/self-hosting/configuration.
S3_PREFIX=
# Required. Generate with: openssl rand -base64 32
DOKPLOY_CREDENTIALS_ENCRYPTION_KEY=

# Optional. Encrypts the SMTP password saved in Agency > Mail (falls back to AI_SETTINGS_ENCRYPTION_KEY).
# Generate with: openssl rand -base64 32
# SECRETS_ENCRYPTION_KEY=
# Optional. Encrypts the OpenRouter key saved in Agency > AI. Leave unset to keep AI features off.
# Generate with: openssl rand -base64 32
AI_SETTINGS_ENCRYPTION_KEY=
# Optional. Encrypts the Cloudflare API tokens saved in each client's Deployment settings.
# Leave unset to keep Cloudflare deployments off. Generate with: openssl rand -base64 32
# CLOUDFLARE_CREDENTIALS_ENCRYPTION_KEY=

# Optional operations settings (see https://docs.arecacms.com/docs/self-hosting/operations). Leave unset for defaults.
# /api/metrics is 404 unless METRICS_TOKEN (min 16 chars) is set: openssl rand -hex 32
# METRICS_TOKEN=
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_IN_TX_TIMEOUT_MS=30000
# DB_POOL_MAX=10
# READINESS_TIMEOUT_MS=3000
# READINESS_MAX_QUEUE_AGE_SECONDS=900
# READINESS_MAX_TICK_AGE_SECONDS=300

# Optional: token required on /setup to create the first admin (16+ characters).
# Leave unset to have the CMS generate one and print it in its logs
# (docker compose logs cms) on the first visit to /setup.
# SETUP_TOKEN=
