CMS_IMAGE=ghcr.io/ekozf/areca-cms:latest
CMS_PORT=3000
CMS_URL=http://localhost:3000

# Replace these demo values before starting a shared instance.
POSTGRES_PASSWORD=areca-demo-password
# Required. The CMS refuses to start in production without a real value.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
S3_ACCESS_KEY=areca-demo
S3_SECRET_KEY=areca-demo-storage-secret
# Required. Generate with: openssl rand -base64 32
DOKPLOY_CREDENTIALS_ENCRYPTION_KEY=

# Optional operations settings (see docs/OPERATIONS.md). Leave unset for defaults.
# /api/metrics is 404 unless METRICS_TOKEN (min 16 chars) is set: openssl rand -hex 32
# METRICS_TOKEN=
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_IN_TX_TIMEOUT_MS=30000
# READINESS_TIMEOUT_MS=3000
# READINESS_MAX_QUEUE_AGE_SECONDS=900
# READINESS_MAX_TICK_AGE_SECONDS=300

# Optional: token required on /setup to create the first admin (16+ characters).
# Leave unset to have the CMS generate one and print it in its logs
# (docker compose logs cms) on the first visit to /setup.
# SETUP_TOKEN=
