{
  "name": "@areca/cms",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "dev:lan": "vite dev --port 3000 --strictPort --host 0.0.0.0",
    "dokploy:setup": "tsx --env-file=.env.local scripts/dokploy-setup.ts",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && tsc --noEmit",
    "test": "vitest run",
    "test:storage": "vitest run --config s3-prefix.vitest.test.config.ts",
    "test:scripts": "node --test scripts/*.test.mjs scripts/lib/*.test.mjs",
    "scan:client": "node scripts/scan-client-bundle.mjs",
    "test:e2e": "playwright test --project=setup --project=chromium",
    "test:smoke": "playwright test --project=smoke",
    "test:e2e:qa": "playwright test --project=qa",
    "test:e2e:isolated": "node scripts/e2e-isolated.mjs --project=setup --project=chromium",
    "test:e2e:qa:isolated": "node scripts/e2e-isolated.mjs --project=qa",
    "docs:screenshots": "playwright test --config=playwright.docs.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "paraglide:scripts": "paraglide-js compile --project ./project.inlang --outdir ./node_modules/.cache/areca-scripts/paraglide --is-server true --silent --no-emit-readme --no-emit-git-ignore --no-emit-prettier-ignore",
    "db:seed": "pnpm run paraglide:scripts && tsx --env-file=.env.local --import ./scripts/lib/script-runtime.mjs scripts/seed.ts",
    "bench": "pnpm run paraglide:scripts && tsx scripts/benchmark.ts",
    "db:reset": "tsx --env-file=.env.local scripts/reset.ts",
    "db:demo": "tsx --env-file=.env.local scripts/lib/local-db-guard.ts && pnpm run db:reset && pnpm run paraglide:scripts && tsx --env-file=.env.local --import ./scripts/lib/script-runtime.mjs scripts/demo-seed.ts",
    "s3:init": "tsx --env-file=.env.local scripts/ensure-bucket.ts",
    "assets:import-external": "pnpm run paraglide:scripts && tsx --env-file=.env.local --import ./scripts/lib/script-runtime.mjs scripts/import-external-images.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@better-auth/oauth-provider": "1.7.15",
    "@better-auth/sso": "^1.7.15",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/ai": "^1.0.1",
    "@tanstack/ai-openrouter": "^1.0.1",
    "@tanstack/highlight": "^1.2.11",
    "@tanstack/markdown": "1.2.0",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-devtools": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-code": "^3.32.2",
    "@tiptap/extension-code-block": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.9.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "nodemailer": "10.3.1",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^6.3.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
