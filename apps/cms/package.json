{
  "name": "@areca/cms",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:lan": "vite dev --port 3000 --host 0.0.0.0",
    "dokploy:setup": "tsx --env-file=.env.local scripts/dokploy-setup.ts",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=setup --project=chromium",
    "test:e2e:qa": "playwright test --project=qa",
    "test:e2e:isolated": "node scripts/e2e-isolated.mjs --project=setup --project=chromium",
    "test:e2e:qa:isolated": "node scripts/e2e-isolated.mjs --project=qa",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "paraglide:scripts": "paraglide-js compile --project ./project.inlang --outdir ./node_modules/.cache/areca-scripts/paraglide --is-server true --silent --no-emit-readme --no-emit-git-ignore --no-emit-prettier-ignore",
    "db:seed": "pnpm -s paraglide:scripts && tsx --env-file=.env.local --import ./scripts/lib/script-runtime.mjs scripts/seed.ts",
    "db:reset": "tsx --env-file=.env.local scripts/reset.ts",
    "s3:init": "tsx --env-file=.env.local scripts/ensure-bucket.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@better-auth/sso": "^1.7.5",
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/markdown": "0.0.15",
    "@tanstack/match-sorter-utils": "9.1.2",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.54",
    "@tanstack/react-table": "9.2.4",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "happy-dom": "^20.14.5",
    "motion": "^13.4.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260903-beta",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "redis": "^6.2.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.167.36",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
