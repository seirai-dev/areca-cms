# Required (see apps/cms/src/env.ts)
DATABASE_URL=postgres://areca:areca@localhost:5432/areca
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
# Local images/preview use this origin. For Dokploy builds use the LAN URL
# (e.g. http://192.168.x.x:3000) so the site can fetch snapshots and assets.
APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
# Enable only behind a trusted reverse proxy that replaces forwarding headers.
RATE_LIMIT_TRUST_PROXY=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=areca
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=cms@areca.local
DOKPLOY_URL=http://192.168.0.141:3000
DOKPLOY_ALLOW_INSECURE_HTTP=true # Local/LAN development only; omit in production
ALLOW_PRIVATE_HEALTH_CHECKS=true # Local/LAN development only; omit in production

# Optional
# SERVER_URL=http://localhost:3000
S3_FORCE_PATH_STYLE=true
DOKPLOY_API_KEY=
# Set to false to disable the in-process publish worker/scheduler
WORKER_ENABLED=true
# VITE_APP_TITLE=Areca
