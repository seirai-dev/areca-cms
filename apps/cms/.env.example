# Required (see apps/cms/src/env.ts)
DATABASE_URL=postgres://areca:areca@localhost:5432/areca
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
# Local images/preview use this origin. For Dokploy builds use the LAN URL
# (e.g. http://192.168.x.x:3000) so the site can fetch snapshots and assets.
APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
# Enable only behind a trusted reverse proxy that replaces forwarding headers.
RATE_LIMIT_TRUST_PROXY=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=areca
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
# Optional installation path in a shared private bucket. Unset/empty = bucket root.
# Examples: areca or sites/production; /areca/ normalizes to areca.
# Rejects slash-only, whitespace/control chars, backslashes, internal //, . or .. segments.
# All CMS and maintenance writers must agree. No automatic migration/root fallback.
# Reset deletes every object in this subtree (whole bucket when unset/empty).
# Scopes requests only, not credential permissions. See https://docs.arecacms.com/docs/self-hosting/configuration.
S3_PREFIX=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=cms@areca.local
# Optional: SMTP_USER, SMTP_PASSWORD, SMTP_SECURE (starttls|tls|none),
# SMTP_REPLY_TO. Agency → Mail settings replace these when saved.
# Optional legacy connection used only when DOKPLOY_DEV_FALLBACK_ENABLED=true.
DOKPLOY_URL=http://192.168.1.10:3000
DOKPLOY_ALLOW_INSECURE_HTTP=true # Local/LAN development only; omit in production
ALLOW_PRIVATE_HEALTH_CHECKS=true # Local/LAN development only; omit in production

# Sign-in methods
# Email/password sign-in. Set to false to remove the form and block the
# endpoint. The one-time /setup bootstrap always accepts a password so the
# instance can never be locked out.
AUTH_EMAIL_PASSWORD_ENABLED=true
# Social providers: a provider appears on the sign-in page only when both of
# its values are set. Leave them blank to remove the provider entirely.
# Callback URL to register with the provider:
#   <BETTER_AUTH_URL>/api/auth/callback/<github|google|discord>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Microsoft Entra ID SSO (OIDC). Shown once client id + secret are set.
# Redirect URI to register in Entra:
#   <BETTER_AUTH_URL>/api/auth/sso/callback/microsoft
MICROSOFT_SSO_CLIENT_ID=
MICROSOFT_SSO_CLIENT_SECRET=
# Directory (tenant) id. Required: the multi-tenant `common` endpoint
# advertises a templated issuer that cannot be validated.
MICROSOFT_SSO_TENANT_ID=
# Email domain owned by the tenant. Needed for Microsoft sign-in to link to
# existing accounts and accept invitations (Entra sends no email_verified).
# MICROSOFT_SSO_DOMAIN=example.com

# Isolated E2E ignores inherited S3_PREFIX; E2E_S3_PREFIX defaults to empty.
# E2E_S3_PREFIX=tests/browser

# Optional
# SERVER_URL=http://localhost:3000
S3_FORCE_PATH_STYLE=true
DOKPLOY_API_KEY=
# Base64-encoded 32-byte key used to encrypt organization Dokploy API keys.
# Generate with: openssl rand -base64 32
DOKPLOY_CREDENTIALS_ENCRYPTION_KEY=
# Base64-encoded 32-byte key used to encrypt the Cloudflare API tokens saved per
# client. The Cloudflare card cannot save credentials until it is set.
# Generate with: openssl rand -base64 32
CLOUDFLARE_CREDENTIALS_ENCRYPTION_KEY=
# Development and e2e only: point the Cloudflare API client at a local stub.
# Ignored when NODE_ENV=production. Default: https://api.cloudflare.com/client/v4
# CLOUDFLARE_API_BASE_URL=http://127.0.0.1:4607/client/v4
# Local development only: allow sites without DB credentials to use the
# DOKPLOY_URL / DOKPLOY_API_KEY pair above. Ignored in production.
DOKPLOY_DEV_FALLBACK_ENABLED=false
# Base64-encoded 32-byte key used to encrypt the OpenRouter API key saved on
# /agency/ai. AI SEO generation stays off until it is set.
# Generate with: openssl rand -base64 32
AI_SETTINGS_ENCRYPTION_KEY=
# Encrypts the stored SMTP password. Falls back to AI_SETTINGS_ENCRYPTION_KEY
# when unset. Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=
# Set to false to disable the in-process publish worker/scheduler
WORKER_ENABLED=true
# VITE_APP_TITLE=Areca

# Operations (all optional; see https://docs.arecacms.com/docs/self-hosting/operations)
# /api/metrics returns 404 unless a bearer token (min 16 chars) is set.
# Generate with: openssl rand -hex 32
# METRICS_TOKEN=
# LOG_LEVEL=info
# Startup waits (PostgreSQL, migration lock, S3) share one deadline; exits 1 when it passes.
# STARTUP_DEADLINE_SECONDS=60
# Send the Content-Security-Policy as Report-Only (violations logged, nothing blocked).
# CSP_REPORT_ONLY=false
# Postgres deadlines in ms (0 disables)
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_IDLE_IN_TX_TIMEOUT_MS=30000
# Readiness (/api/health/ready) thresholds
# READINESS_TIMEOUT_MS=3000
# READINESS_MAX_QUEUE_AGE_SECONDS=900
# READINESS_MAX_TICK_AGE_SECONDS=300

# First-run setup protection. /setup asks for this token before it creates the
# first admin (16+ characters). Leave unset to have the CMS generate one and
# print it once in the server log while no user exists.
# SETUP_TOKEN=
# Agency admins must enrol in two-factor (TOTP) before using admin features.
# Set to false only for throwaway dev/e2e stacks.
# ADMIN_MFA_REQUIRED=true
