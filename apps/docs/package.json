{
  "name": "@areca/docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3100 --strictPort",
    "build": "vite build && node scripts/check-anchors.mjs && node scripts/check-install-versions.mjs",
    "preview": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "check:versions": "node scripts/check-install-versions.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/start-static-server-functions": "1.167.44",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.1",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
