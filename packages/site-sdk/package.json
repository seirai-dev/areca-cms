{
  "name": "@areca-cms/site-sdk",
  "version": "0.2.0",
  "description": "Schema, content sync, and preview tools for sites powered by Areca CMS.",
  "keywords": [
    "areca",
    "cms",
    "content",
    "sdk",
    "static-site"
  ],
  "homepage": "https://github.com/ekozf/areca-cms/tree/master/packages/site-sdk#readme",
  "bugs": {
    "url": "https://github.com/ekozf/areca-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekozf/areca-cms.git",
    "directory": "packages/site-sdk"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "areca": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pull": {
      "types": "./dist/pull.d.ts",
      "import": "./dist/pull.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "import": "./dist/rich-text.js"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "import": "./dist/seo.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc && node --eval \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepack": "pnpm test && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@tanstack/markdown": "0.0.15"
  }
}
